{
  "$schema": "./resources/config.okenv.schema.json",
  "scripts": {
    "build": {
      "command": "go",
      "args": ["build", "-o", "dist/local/okenv", "./cmd/okenv"],
      "overrides": [
        {
          "os": "windows",
          "arch": ["amd64", "arm64"],
          "command": "go",
          "args": ["build", "-o", "dist/local/okenv.exe", "./cmd/okenv"]
        }
      ]
    },
    "format": {
      "command": "golangci-lint",
      "args": ["fmt"]
    },
    "build:windows:amd64": {
      "command": "go",
      "args": ["build", "-o", "dist/windows/amd64/okenv.exe", "./cmd/okenv"],
      "env": {
        "GOOS": {
          "value": "windows"
        },
        "GOARCH": {
          "value": "amd64"
        },
        "CGO_ENABLED": {
          "value": "0"
        }
      }
    },
    "build:windows:arm64": {
      "command": "go",
      "args": ["build", "-o", "dist/windows/arm64/okenv.exe", "./cmd/okenv"],
